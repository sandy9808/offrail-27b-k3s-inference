# Build this from the CUDA 12.4 sm86/sm89 bundle supplied by the upstream
# local-ai-on-your-gaming-gpu project. That custom llama.cpp build is required
# for the model's PTQ1_0 format; generic upstream llama.cpp images are not used.
FROM ubuntu:22.04
COPY runtime/bonsai2-small-gpu-linux-x64-cuda12.4-sm86-sm89-285542d/ /opt/offrail/
ENV LD_LIBRARY_PATH=/opt/offrail/lib
WORKDIR /opt/offrail
ENTRYPOINT ["/opt/offrail/bin/llama-server"]
